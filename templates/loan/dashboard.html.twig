{% extends 'frontend/base.html.twig' %}

{% block title %}{% trans %}Mes Prêts{% endtrans %} - EdgeLoan{% endblock %}

{% block meta_description %}{% trans %}Gérez vos demandes de prêt, suivez vos contrats et vos paiements sur votre tableau de bord personnel EdgeLoan.{% endtrans %}{% endblock %}

{% block body %}
<div class="container my-5 pt-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="fw-bold mb-2">{% trans %}Mes Prêts{% endtrans %}</h1>
                    <p class="text-muted">{% trans %}Bienvenue{% endtrans %} {{ user.firstName ?? user.email }}, {% trans %}gérez vos prêts facilement{% endtrans %}</p>
                </div>
                <a href="{{ path('loan_apply') }}" class="btn btn-primary-modern">
                    <i class="fas fa-plus me-2"></i>{% trans %}Nouvelle Demande{% endtrans %}
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4 mb-5">
        {% set activeLoans = applications|filter(app => app.status == 'active')|length %}
        {% set pendingLoans = applications|filter(app => app.status == 'pending')|length %}
        {% set totalAmount = 0 %}
        {% for app in applications %}
            {% if app.status in ['active', 'approved'] %}
                {% set totalAmount = totalAmount + app.requestedAmount %}
            {% endif %}
        {% endfor %}
        
        <div class="col-md-3 col-sm-6">
            <div class="card-modern p-4 text-center">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="fas fa-file-alt fa-xl text-primary"></i>
                </div>
                <h3 class="fw-bold mb-1">{{ applications|length }}</h3>
                <p class="text-muted mb-0">{% trans %}Total Demandes{% endtrans %}</p>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6">
            <div class="card-modern p-4 text-center">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="fas fa-check-circle fa-xl text-success"></i>
                </div>
                <h3 class="fw-bold mb-1">{{ activeLoans }}</h3>
                <p class="text-muted mb-0">{% trans %}Prêts Actifs{% endtrans %}</p>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6">
            <div class="card-modern p-4 text-center">
                <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="fas fa-clock fa-xl text-warning"></i>
                </div>
                <h3 class="fw-bold mb-1">{{ pendingLoans }}</h3>
                <p class="text-muted mb-0">{% trans %}En Attente{% endtrans %}</p>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6">
            <div class="card-modern p-4 text-center">
                <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="fas fa-euro-sign fa-xl text-info"></i>
                </div>
                <h3 class="fw-bold mb-1">{{ (totalAmount/1000)|number_format(0) }}K€</h3>
                <p class="text-muted mb-0">{% trans %}Montant Total{% endtrans %}</p>
            </div>
        </div>
    </div>

    {% if applications|length > 0 %}
        <!-- Applications List -->
        <div class="card-modern">
            <div class="card-header">
                <h3 class="card-title mb-0">
                    <i class="fas fa-list me-2"></i>{% trans %}Mes Demandes de Prêt{% endtrans %}
                </h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>{% trans %}Type{% endtrans %}</th>
                                <th>{% trans %}Montant{% endtrans %}</th>
                                <th>{% trans %}Durée{% endtrans %}</th>
                                <th>{% trans %}Statut{% endtrans %}</th>
                                <th>{% trans %}Date{% endtrans %}</th>
                                <th>{% trans %}Actions{% endtrans %}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for application in applications %}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                {% set typeIcon = {
                                                    'personal': 'fa-user',
                                                    'business': 'fa-building',
                                                    'auto': 'fa-car',
                                                    'home': 'fa-home',
                                                    'education': 'fa-graduation-cap'
                                                } %}
                                                <i class="fas {{ typeIcon[application.loanType] ?? 'fa-file-alt' }} fa-lg text-muted"></i>
                                            </div>
                                            <div>
                                                <div class="fw-medium">
                                                    {% set typeLabels = {
                                                        'personal': 'Personnel',
                                                        'business': 'Entreprise',
                                                        'auto': 'Automobile',
                                                        'home': 'Immobilier',
                                                        'education': 'Éducation'
                                                    } %}
                                                    {% trans %}{{ typeLabels[application.loanType] ?? application.loanType }}{% endtrans %}
                                                </div>
                                                {% if application.purpose %}
                                                    <small class="text-muted">{{ application.purpose|slice(0, 30) }}{% if application.purpose|length > 30 %}...{% endif %}</small>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold">{{ application.requestedAmount|number_format(0, ',', ' ') }}€</span>
                                    </td>
                                    <td>{{ application.requestedDuration }} {% trans %}mois{% endtrans %}</td>
                                    <td>
                                        {% set statusClass = {
                                            'pending': 'warning',
                                            'approved': 'success',
                                            'rejected': 'danger',
                                            'active': 'info',
                                            'completed': 'secondary'
                                        } %}
                                        <span class="badge bg-{{ statusClass[application.status] ?? 'secondary' }}">
                                            {% set statusLabels = {
                                                'pending': 'En Attente',
                                                'approved': 'Approuvé',
                                                'rejected': 'Rejeté',
                                                'active': 'Actif',
                                                'completed': 'Terminé'
                                            } %}
                                            {% trans %}{{ statusLabels[application.status] ?? application.status }}{% endtrans %}
                                        </span>
                                    </td>
                                    <td>
                                        <div>{{ application.createdAt|date('d/m/Y') }}</div>
                                        <small class="text-muted">{{ application.createdAt|date('H:i') }}</small>
                                    </td>
                                    <td>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" href="{{ path('loan_application_show', {'id': application.id}) }}">
                                                        <i class="fas fa-eye me-2"></i>{% trans %}Voir Détails{% endtrans %}
                                                    </a>
                                                </li>
                                                {% if application.contract %}
                                                    <li>
                                                        <a class="dropdown-item" href="{{ path('loan_contract_view', {'id': application.contract.id}) }}">
                                                            <i class="fas fa-file-contract me-2"></i>{% trans %}Voir Contrat{% endtrans %}
                                                        </a>
                                                    </li>
                                                {% endif %}
                                                {% if application.status == 'pending' %}
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item text-muted" href="#">
                                                            <i class="fas fa-edit me-2"></i>{% trans %}Modifier{% endtrans %} ({% trans %}Bientôt{% endtrans %})
                                                        </a>
                                                    </li>
                                                {% endif %}
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <!-- Empty State -->
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fas fa-file-alt fa-4x text-muted opacity-50"></i>
            </div>
            <h3 class="fw-bold mb-3">{% trans %}Aucune demande de prêt{% endtrans %}</h3>
            <p class="text-muted mb-4">{% trans %}Vous n'avez pas encore fait de demande de prêt. Commencez dès maintenant !{% endtrans %}</p>
            <a href="{{ path('loan_apply') }}" class="btn btn-primary-modern btn-lg">
                <i class="fas fa-plus me-2"></i>{% trans %}Ma Première Demande{% endtrans %}
            </a>
        </div>
    {% endif %}

    <!-- Quick Actions -->
    <div class="row mt-5">
        <div class="col-md-4 mb-3">
            <div class="card-modern text-center h-100">
                <div class="card-body p-4">
                    <i class="fas fa-user-cog fa-3x text-primary mb-3"></i>
                    <h5 class="fw-bold mb-3">{% trans %}Mon Profil{% endtrans %}</h5>
                    <p class="text-muted">{% trans %}Gérez vos informations personnelles et vos préférences{% endtrans %}</p>
                    <a href="{{ path('loan_profile') }}" class="btn btn-outline-primary">{% trans %}Accéder{% endtrans %}</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-3">
            <div class="card-modern text-center h-100">
                <div class="card-body p-4">
                    <i class="fas fa-headset fa-3x text-success mb-3"></i>
                    <h5 class="fw-bold mb-3">{% trans %}Support Client{% endtrans %}</h5>
                    <p class="text-muted">{% trans %}Besoin d'aide ? Notre équipe est là pour vous accompagner{% endtrans %}</p>
                    <a href="{{ path('contact') }}" class="btn btn-outline-success">{% trans %}Contacter{% endtrans %}</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-3">
            <div class="card-modern text-center h-100">
                <div class="card-body p-4">
                    <i class="fas fa-calculator fa-3x text-info mb-3"></i>
                    <h5 class="fw-bold mb-3">{% trans %}Simulateur{% endtrans %}</h5>
                    <p class="text-muted">{% trans %}Calculez vos mensualités et trouvez l'offre qui vous convient{% endtrans %}</p>
                    <a href="#" class="btn btn-outline-info" onclick="alert('{% trans %}Simulateur à venir prochainement{% endtrans %}')">{% trans %}Calculer{% endtrans %}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Animation pour les cartes de statistiques
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.card-modern');
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '0';
                    entry.target.style.transform = 'translateY(20px)';
                    entry.target.style.transition = 'all 0.6s ease-out';
                    
                    setTimeout(() => {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }, 100);
                }
            });
        });
        
        cards.forEach(card => {
            observer.observe(card);
        });
    });
</script>
{% endblock %}