{% if languages is defined and languages|length > 1 %}
<div class="dropdown">
    <button class="btn btn-outline-modern dropdown-toggle btn-sm" 
            type="button" 
            id="languageDropdown" 
            data-bs-toggle="dropdown" 
            aria-expanded="false">
        <i class="fas fa-globe me-1"></i>
        <span>{{ app.request.locale|upper }}</span>
    </button>
    <ul class="dropdown-menu language-dropdown" aria-labelledby="languageDropdown">
        {% for language in languages %}
            <li>
                <a class="language-option dropdown-item {{ app.request.locale == language.code ? 'active' : '' }}" 
                   href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': language.code})) }}"
                   lang="{{ language.code }}"
                   hreflang="{{ language.code }}">
                    <i class="fas fa-flag me-2"></i>
                    <span>{{ language.nativeName ?? language.name }}</span>
                    {% if language.isDefault() %}
                        <i class="fas fa-star text-warning ms-auto"></i>
                    {% endif %}
                    {% if app.request.locale == language.code %}
                        <i class="fas fa-check text-success ms-auto"></i>
                    {% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>
</div>
{% endif %}