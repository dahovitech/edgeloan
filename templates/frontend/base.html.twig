<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'site.name'|trans }} - {{ 'homepage.title'|trans }}{% endblock %}</title>
    
    <!-- Meta Tags -->
    <meta name="description" content="{% block meta_description %}{{ 'site.meta_description'|trans }}{% endblock %}">
    <meta name="keywords" content="{{ 'site.meta_keywords'|trans }}">
    <meta name="author" content="EdgeLoan">
    
    <!-- Open Graph -->
    <meta property="og:title" content="{% block og_title %}{{ 'site.name'|trans }} - {{ 'homepage.title'|trans }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ 'site.og_description'|trans }}{% endblock %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.uri }}">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    
    <!-- Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    {% block stylesheets %}
    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #3b82f6;
            --secondary-color: #64748b;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --info-color: #06b6d4;
            --light-color: #f8fafc;
            --dark-color: #1e293b;
            --border-radius: 12px;
            --box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --box-shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        * {
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.6;
            color: var(--dark-color);
            background-color: #ffffff;
            margin: 0;
        }
        
        /* Modern Navigation */
        .navbar-modern {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: var(--box-shadow);
            transition: var(--transition);
        }
        
        .navbar-modern.scrolled {
            background: rgba(255, 255, 255, 0.98);
        }
        
        .navbar-brand-modern {
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--primary-color);
            text-decoration: none;
            transition: var(--transition);
        }
        
        .navbar-brand-modern:hover {
            color: var(--primary-dark);
            text-decoration: none;
        }
        
        .nav-link-modern {
            font-weight: 500;
            color: var(--secondary-color);
            padding: 0.75rem 1rem;
            border-radius: var(--border-radius);
            transition: var(--transition);
            text-decoration: none;
        }
        
        .nav-link-modern:hover {
            color: var(--primary-color);
            background-color: rgba(37, 99, 235, 0.05);
        }
        
        .nav-link-modern.active {
            color: var(--primary-color);
            background-color: rgba(37, 99, 235, 0.1);
        }
        
        /* Modern Buttons */
        .btn-modern {
            font-weight: 500;
            border-radius: var(--border-radius);
            padding: 0.75rem 2rem;
            border: none;
            transition: var(--transition);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        
        .btn-primary-modern {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
            color: white;
            box-shadow: var(--box-shadow);
        }
        
        .btn-primary-modern:hover {
            transform: translateY(-2px);
            box-shadow: var(--box-shadow-lg);
            color: white;
        }
        
        .btn-outline-modern {
            background: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
        }
        
        .btn-outline-modern:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-2px);
        }
        
        /* Modern Cards */
        .card-modern {
            border: none;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            transition: var(--transition);
            background: white;
            overflow: hidden;
        }
        
        .card-modern:hover {
            transform: translateY(-4px);
            box-shadow: var(--box-shadow-lg);
        }
        
        .card-modern .card-header {
            background: linear-gradient(135deg, var(--light-color) 0%, #e2e8f0 100%);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            font-weight: 600;
        }
        
        /* Hero Section */
        .hero-modern {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 50%, #1e40af 100%);
            color: white;
            padding: 6rem 0;
            position: relative;
            overflow: hidden;
        }
        
        .hero-modern::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="1000" height="1000" fill="url(%23grain)"/></svg>');
            pointer-events: none;
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
        }
        
        /* Modern Form Elements */
        .form-control-modern {
            border: 2px solid rgba(0, 0, 0, 0.1);
            border-radius: var(--border-radius);
            padding: 0.875rem 1rem;
            font-weight: 400;
            transition: var(--transition);
        }
        
        .form-control-modern:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
            outline: none;
        }
        
        /* Alerts */
        .alert-modern {
            border: none;
            border-radius: var(--border-radius);
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            font-weight: 500;
        }
        
        .alert-success-modern {
            background: rgba(16, 185, 129, 0.1);
            color: #065f46;
            border-left: 4px solid var(--success-color);
        }
        
        .alert-danger-modern {
            background: rgba(239, 68, 68, 0.1);
            color: #991b1b;
            border-left: 4px solid var(--danger-color);
        }
        
        .alert-info-modern {
            background: rgba(6, 182, 212, 0.1);
            color: #0c4a6e;
            border-left: 4px solid var(--info-color);
        }
        
        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* Language Selector */
        .language-selector {
            position: relative;
        }
        
        .language-dropdown {
            background: white;
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow-lg);
            min-width: 150px;
        }
        
        .language-option {
            padding: 0.5rem 1rem;
            color: var(--dark-color);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: var(--transition);
        }
        
        .language-option:hover {
            background: var(--light-color);
            color: var(--primary-color);
        }
        
        /* Footer */
        .footer-modern {
            background: var(--dark-color);
            color: #e2e8f0;
            padding: 3rem 0 2rem;
            margin-top: auto;
        }
        
        .footer-link {
            color: #cbd5e1;
            text-decoration: none;
            transition: var(--transition);
        }
        
        .footer-link:hover {
            color: var(--primary-light);
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-modern {
                padding: 4rem 0;
            }
            
            .navbar-nav {
                background: white;
                border-radius: var(--border-radius);
                padding: 1rem;
                margin-top: 1rem;
                box-shadow: var(--box-shadow);
            }
        }
        
        /* Utility Classes */
        .text-gradient {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .glass {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .hover-lift {
            transition: var(--transition);
        }
        
        .hover-lift:hover {
            transform: translateY(-4px);
        }
    </style>
    {% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-modern fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand-modern" href="{{ path('homepage') }}">
                <i class="fas fa-coins me-2"></i>EdgeLoan
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link-modern {{ app.request.get('_route') == 'homepage' ? 'active' : '' }}" href="{{ path('homepage') }}">
                            <i class="fas fa-home me-1"></i>{% trans %}Accueil{% endtrans %}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-modern {{ app.request.get('_route') starts with 'frontend_service' ? 'active' : '' }}" href="{{ path('frontend_service_index') }}">
                            <i class="fas fa-list me-1"></i>{% trans %}Services{% endtrans %}
                        </a>
                    </li>
                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item">
                            <a class="nav-link-modern {{ app.request.get('_route') starts with 'loan' ? 'active' : '' }}" href="{{ path('loan_dashboard') }}">
                                <i class="fas fa-chart-line me-1"></i>{% trans %}Mes Prêts{% endtrans %}
                            </a>
                        </li>
                    {% endif %}
                    <li class="nav-item">
                        <a class="nav-link-modern {{ app.request.get('_route') == 'about' ? 'active' : '' }}" href="{{ path('about') }}">
                            <i class="fas fa-info-circle me-1"></i>{% trans %}À Propos{% endtrans %}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-modern {{ app.request.get('_route') == 'contact' ? 'active' : '' }}" href="{{ path('contact') }}">
                            <i class="fas fa-envelope me-1"></i>{% trans %}Contact{% endtrans %}
                        </a>
                    </li>
                </ul>
                
                <div class="d-flex align-items-center gap-3">
                    <!-- Language Selector -->
                    <div class="language-selector">
                        {{ include('components/language_selector.html.twig') }}
                    </div>
                    
                    <!-- User Menu -->
                    {% if is_granted('ROLE_USER') %}
                        <div class="dropdown">
                            <button class="btn btn-outline-modern dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user me-1"></i>{{ app.user.firstName ?? app.user.email }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="{{ path('loan_dashboard') }}"><i class="fas fa-chart-line me-2"></i>{% trans %}Tableau de Bord{% endtrans %}</a></li>
                                <li><a class="dropdown-item" href="{{ path('loan_profile') }}"><i class="fas fa-user-cog me-2"></i>{% trans %}Mon Profil{% endtrans %}</a></li>
                                <li><hr class="dropdown-divider"></li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}"><i class="fas fa-cogs me-2"></i>{% trans %}Administration{% endtrans %}</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                {% endif %}
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt me-2"></i>{% trans %}Déconnexion{% endtrans %}</a></li>
                            </ul>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-outline-modern">
                            <i class="fas fa-sign-in-alt me-1"></i>{% trans %}Connexion{% endtrans %}
                        </a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary-modern">
                            <i class="fas fa-user-plus me-1"></i>{% trans %}S'inscrire{% endtrans %}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <!-- Flash Messages -->
    <div class="container mt-5 pt-4">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }}-modern alert-dismissible fade show" role="alert">
                    <i class="fas fa-{{ type == 'success' ? 'check-circle' : type == 'error' or type == 'danger' ? 'exclamation-circle' : 'info-circle' }} me-2"></i>
                    {{ message | trans }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <!-- Main Content -->
    <main class="flex-grow-1">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="footer-modern mt-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <h5 class="text-white mb-3">
                        <i class="fas fa-coins me-2"></i>EdgeLoan
                    </h5>
                    <p class="mb-3">{% trans %}Votre partenaire de confiance pour tous vos besoins de financement. Solution moderne, rapide et sécurisée.{% endtrans %}</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="footer-link"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="footer-link"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="footer-link"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#" class="footer-link"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-white mb-3">{% trans %}Services{% endtrans %}</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="{{ path('frontend_service_index') }}" class="footer-link">{% trans %}Prêt Personnel{% endtrans %}</a></li>
                        <li class="mb-2"><a href="{{ path('frontend_service_index') }}" class="footer-link">{% trans %}Prêt Entreprise{% endtrans %}</a></li>
                        <li class="mb-2"><a href="{{ path('frontend_service_index') }}" class="footer-link">{% trans %}Prêt Automobile{% endtrans %}</a></li>
                        <li class="mb-2"><a href="{{ path('frontend_service_index') }}" class="footer-link">{% trans %}Prêt Immobilier{% endtrans %}</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-white mb-3">{% trans %}Société{% endtrans %}</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="{{ path('about') }}" class="footer-link">{% trans %}À Propos{% endtrans %}</a></li>
                        <li class="mb-2"><a href="{{ path('contact') }}" class="footer-link">{% trans %}Contact{% endtrans %}</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}Carrières{% endtrans %}</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}Actualités{% endtrans %}</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-white mb-3">{% trans %}Support{% endtrans %}</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}Centre d'Aide{% endtrans %}</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}FAQ{% endtrans %}</a></li>
                        <li class="mb-2"><a href="{{ path('contact') }}" class="footer-link">{% trans %}Support{% endtrans %}</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}Status{% endtrans %}</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-white mb-3">{% trans %}Légal{% endtrans %}</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}Confidentialité{% endtrans %}</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}Conditions{% endtrans %}</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}Mentions Légales{% endtrans %}</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">{% trans %}Cookies{% endtrans %}</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255, 255, 255, 0.1);">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0">&copy; {{ 'now'|date('Y') }} EdgeLoan. {% trans %}Tous droits réservés.{% endtrans %}</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0">{% trans %}Développé avec{% endtrans %} <i class="fas fa-heart text-danger"></i> {% trans %}par{% endtrans %} <strong>Prudence ASSOGBA</strong></p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}
    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('mainNav');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        // Loading button helper
        function setButtonLoading(button, loading = true) {
            if (loading) {
                button.disabled = true;
                button.innerHTML = button.innerHTML.replace(/<i[^>]*><\/i>/, '<span class="loading me-2"></span>');
            } else {
                button.disabled = false;
                button.innerHTML = button.innerHTML.replace('<span class="loading me-2"></span>', '<i class="fas fa-check me-2"></i>');
            }
        }

        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-modern');
            alerts.forEach(function(alert) {
                if (alert.classList.contains('fade')) {
                    bootstrap.Alert.getOrCreateInstance(alert).close();
                }
            });
        }, 5000);

        // Form validation helper
        function validateForm(form) {
            let isValid = true;
            const requiredFields = form.querySelectorAll('[required]');
            
            requiredFields.forEach(function(field) {
                if (!field.value.trim()) {
                    field.classList.add('is-invalid');
                    isValid = false;
                } else {
                    field.classList.remove('is-invalid');
                }
            });
            
            return isValid;
        }
    </script>
    {% endblock %}
</body>
</html>