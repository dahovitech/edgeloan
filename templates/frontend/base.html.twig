{% extends 'base.html.twig' %}

{% block header %}
    {# Frontend Header #}
    <header class="frontend-header" role="banner">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm" 
             role="navigation" 
             aria-label="{{ 'accessibility.main_navigation'|trans|default('Navigation principale') }}">
            <div class="container">
                {# Brand Logo #}
                <a class="navbar-brand fw-bold d-flex align-items-center" 
                   href="{{ path('frontend_homepage', {'_locale': app.request.locale}) }}"
                   aria-label="{{ 'navigation.home'|trans }} - {{ 'site.name'|trans|default('Opencms') }}">
                    <i class="bi bi-star-fill text-primary me-2" aria-hidden="true"></i>
                    <span>Opencms</span>
                </a>

                {# Mobile Toggle Button #}
                <button class="navbar-toggler" 
                        type="button" 
                        data-bs-toggle="collapse" 
                        data-bs-target="#navbarMain"
                        aria-controls="navbarMain"
                        aria-expanded="false"
                        aria-label="{{ 'accessibility.toggle_navigation'|trans|default('Basculer la navigation') }}">
                    <span class="navbar-toggler-icon"></span>
                </button>

                {# Main Navigation #}
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto" role="menubar">
                        <li class="nav-item" role="none">
                            <a class="nav-link{% if app.request.get('_route') == 'frontend_homepage' %} active{% endif %}" 
                               href="{{ path('frontend_homepage', {'_locale': app.request.locale}) }}"
                               role="menuitem"
                               {% if app.request.get('_route') == 'frontend_homepage' %}aria-current="page"{% endif %}>
                                <i class="bi bi-house me-1" aria-hidden="true"></i>
                                <span>{{ 'navigation.home'|trans }}</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link{% if app.request.get('_route') starts with 'frontend_services_' %} active{% endif %}" 
                               href="{{ path('frontend_services_index', {'_locale': app.request.locale}) }}"
                               role="menuitem"
                               {% if app.request.get('_route') starts with 'frontend_services_' %}aria-current="page"{% endif %}>
                                <i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i>
                                <span>{{ 'navigation.services'|trans }}</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link{% if app.request.get('_route') == 'frontend_contact' %} active{% endif %}" 
                               href="{{ path('frontend_contact', {'_locale': app.request.locale}) }}"
                               role="menuitem"
                               {% if app.request.get('_route') == 'frontend_contact' %}aria-current="page"{% endif %}>
                                <i class="bi bi-envelope me-1" aria-hidden="true"></i>
                                <span>{{ 'navigation.contact'|trans }}</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link{% if app.request.get('_route') == 'frontend_about' %} active{% endif %}" 
                               href="{{ path('frontend_about', {'_locale': app.request.locale}) }}"
                               role="menuitem"
                               {% if app.request.get('_route') == 'frontend_about' %}aria-current="page"{% endif %}>
                                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                                <span>{{ 'navigation.about'|trans }}</span>
                            </a>
                        </li>
                    </ul>

                    {# Language Selector #}
                    {% if languages is defined and languages|length > 1 %}
                        <div class="dropdown language-selector">
                            <button class="btn btn-outline-primary dropdown-toggle" 
                                    type="button" 
                                    id="languageDropdown" 
                                    data-bs-toggle="dropdown" 
                                    aria-expanded="false"
                                    aria-haspopup="true"
                                    aria-label="{{ 'language.change'|trans }} ({{ 'language.current'|trans }}: {{ app.request.locale|upper }})"
                                    title="{{ 'language.change'|trans }}">
                                <i class="bi bi-translate me-1" aria-hidden="true"></i>
                                <span>{{ app.request.locale|upper }}</span>
                                <span class="visually-hidden">{{ 'language.dropdown_label'|trans|default('Changer de langue') }}</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" 
                                aria-labelledby="languageDropdown"
                                role="menu">
                                {% for language in languages %}
                                    <li role="none">
                                        <a class="dropdown-item{{ app.request.locale == language.code ? ' active' : '' }}" 
                                           href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': language.code})) }}"
                                           role="menuitem"
                                           lang="{{ language.code }}"
                                           hreflang="{{ language.code }}"
                                           {% if app.request.locale == language.code %}aria-current="true"{% endif %}>
                                            <span class="badge bg-primary me-2">{{ language.code|upper }}</span>
                                            <span>{{ language.nativeName|e }}</span>
                                            {% if language.isDefault() %}
                                                <i class="bi bi-star-fill text-warning ms-1" 
                                                   aria-label="{{ 'language.default'|trans }}" 
                                                   title="{{ 'language.default'|trans }}"></i>
                                            {% endif %}
                                            {% if app.request.locale == language.code %}
                                                <i class="bi bi-check ms-auto text-success" 
                                                   aria-hidden="true"></i>
                                            {% endif %}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </div>
        </nav>
    </header>
{% endblock %}

{% block footer %}
    {# Frontend Footer #}
    <footer class="frontend-footer bg-dark text-light mt-auto" 
            role="contentinfo"
            aria-label="{{ 'accessibility.site_footer'|trans|default('Pied de page du site') }}">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-star-fill text-primary me-2" aria-hidden="true"></i>
                        <span>Opencms</span>
                    </h5>
                    <p class="text-muted">{{ 'footer.description'|trans|e }}</p>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3">{{ 'footer.quick_links'|trans }}</h6>
                    <nav aria-label="{{ 'accessibility.footer_navigation'|trans|default('Navigation du pied de page') }}">
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <a href="{{ path('frontend_services_index', {'_locale': app.request.locale}) }}" 
                                   class="text-muted text-decoration-none footer-link">
                                    {{ 'navigation.services'|trans }}
                                </a>
                            </li>
                            <li class="mb-2">
                                <a href="{{ path('frontend_contact', {'_locale': app.request.locale}) }}" 
                                   class="text-muted text-decoration-none footer-link">
                                    {{ 'navigation.contact'|trans }}
                                </a>
                            </li>
                            <li class="mb-2">
                                <a href="{{ path('frontend_about', {'_locale': app.request.locale}) }}" 
                                   class="text-muted text-decoration-none footer-link">
                                    {{ 'navigation.about'|trans }}
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3">{{ 'footer.languages'|trans }}</h6>
                    {% if languages is defined and languages|length > 0 %}
                        <nav aria-label="{{ 'accessibility.language_links'|trans|default('Liens de langue') }}">
                            <div class="d-flex flex-wrap gap-2">
                                {% for language in languages %}
                                    <a href="{{ path(app.request.get('_route'), app.request.get('_route_params')|merge({'_locale': language.code})) }}" 
                                       class="badge {{ app.request.locale == language.code ? 'bg-primary' : 'bg-secondary' }} text-decoration-none footer-lang-link"
                                       lang="{{ language.code }}"
                                       hreflang="{{ language.code }}"
                                       {% if app.request.locale == language.code %}aria-current="true"{% endif %}
                                       aria-label="{{ 'language.switch_to'|trans({'%language%': language.nativeName}) }}">
                                        {{ language.code|upper }}
                                    </a>
                                {% endfor %}
                            </div>
                        </nav>
                    {% endif %}
                </div>
            </div>
            
            <hr class="my-4 border-light opacity-25">
            
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="text-muted small mb-0">
                        <span>&copy; {{ 'now'|date('Y') }} Opencms.</span>
                        <span>{{ 'footer.rights'|trans }}</span>
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-muted">
                        <span>{{ 'footer.powered_by'|trans }} </span>
                        <a href="https://symfony.com" 
                           target="_blank" 
                           rel="noopener noreferrer"
                           class="text-primary text-decoration-none"
                           aria-label="{{ 'footer.symfony_link'|trans|default('Symfony - Ouvre dans un nouvel onglet') }}">
                           Symfony
                           <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i>
                        </a>
                    </small>
                </div>
            </div>
        </div>
    </footer>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# CSS optimisé pour la performance et l'accessibilité #}
    <style>
        /* ==========================================================================
           Frontend Layout & Components - Optimized CSS
           ========================================================================== */
        
        /* Body Layout */
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        /* Main content area */
        main {
            flex: 1;
        }
        
        /* Header & Navigation */
        .frontend-header {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            transition: background-color 0.3s ease;
        }
        
        .frontend-header .navbar-brand {
            font-size: 1.5rem;
            transition: transform 0.2s ease;
        }
        
        .frontend-header .navbar-brand:hover {
            transform: translateY(-2px);
        }
        
        .frontend-header .nav-link {
            position: relative;
            transition: all 0.3s ease;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
        }
        
        .frontend-header .nav-link:hover {
            background-color: rgba(13, 110, 253, 0.1);
            transform: translateY(-1px);
        }
        
        .frontend-header .nav-link.active {
            color: var(--bs-primary) !important;
            font-weight: 500;
            background-color: rgba(13, 110, 253, 0.15);
        }
        
        .frontend-header .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0.75rem;
            right: 0.75rem;
            height: 3px;
            background: var(--bs-primary);
            border-radius: 2px;
        }
        
        /* Language Selector */
        .language-selector .dropdown-toggle {
            border-radius: 0.375rem;
            transition: all 0.3s ease;
        }
        
        .language-selector .dropdown-toggle:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        
        .language-selector .dropdown-item {
            transition: background-color 0.2s ease;
        }
        
        .language-selector .dropdown-item.active {
            background-color: rgba(13, 110, 253, 0.15);
            color: var(--bs-primary);
        }
        
        /* Footer */
        .frontend-footer {
            margin-top: auto;
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        }
        
        .frontend-footer .footer-link:hover,
        .frontend-footer .footer-lang-link:hover {
            color: var(--bs-primary) !important;
            transform: translateX(5px);
            transition: all 0.3s ease;
        }
        
        .footer-lang-link {
            transition: all 0.3s ease;
        }
        
        /* Focus States for Accessibility */
        .nav-link:focus,
        .navbar-brand:focus,
        .btn:focus,
        .dropdown-toggle:focus {
            outline: 2px solid var(--bs-primary);
            outline-offset: 2px;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
        }
        
        /* Skip Link */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 6px;
            background: var(--bs-primary);
            color: white;
            padding: 8px;
            text-decoration: none;
            border-radius: 0 0 4px 4px;
            z-index: 9999;
            font-weight: 500;
        }
        
        .skip-link:focus {
            top: 0;
        }
        
        /* High Contrast Mode Support */
        @media (prefers-contrast: high) {
            .frontend-header {
                background: #fff;
                border-bottom: 2px solid #000;
            }
            
            .nav-link:hover {
                background-color: #000;
                color: #fff !important;
            }
        }
        
        /* Reduced Motion Support */
        @media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
            
            html {
                scroll-behavior: auto;
            }
        }
        
        /* Dark Mode Support */
        @media (prefers-color-scheme: dark) {
            :root {
                --bs-body-bg: #1a1a1a;
                --bs-body-color: #e9ecef;
            }
            
            .frontend-header {
                background: rgba(26, 26, 26, 0.95);
            }
            
            .navbar-light .nav-link {
                color: #e9ecef;
            }
        }
        
        /* Responsive Design */
        @media (max-width: 991.98px) {
            .frontend-header .navbar-brand {
                font-size: 1.25rem;
            }
            
            .navbar-collapse {
                margin-top: 1rem;
                padding-top: 1rem;
                border-top: 1px solid rgba(0,0,0,.125);
            }
            
            .language-selector {
                margin-top: 1rem;
            }
        }
        
        @media (max-width: 767.98px) {
            .frontend-header .navbar-brand {
                font-size: 1.125rem;
            }
            
            .frontend-footer .row > [class*="col-"] {
                margin-bottom: 2rem;
            }
        }
        
        /* Print Styles */
        @media print {
            .frontend-header,
            .frontend-footer,
            #flash-messages,
            #back-to-top {
                display: none !important;
            }
            
            body {
                color: #000;
                background: #fff;
            }
        }
    </style>
{% endblock %}

{% block extra_javascripts %}
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // ==========================================================================
            // Enhanced Frontend JavaScript - Error Handling & Performance Optimized
            // ==========================================================================
            
            try {
                // Auto-hide alerts with improved UX
                const alerts = document.querySelectorAll(".alert:not(.alert-permanent)");
                alerts.forEach(function(alert, index) {
                    // Stagger the timing for multiple alerts
                    const delay = 5000 + (index * 500);
                    
                    setTimeout(function() {
                        try {
                            if (typeof window.bootstrap !== 'undefined' && window.bootstrap.Alert) {
                                const bsAlert = new window.bootstrap.Alert(alert);
                                bsAlert.close();
                            } else {
                                // Graceful fallback with animation
                                alert.style.transition = 'opacity 0.5s ease-out';
                                alert.style.opacity = '0';
                                setTimeout(() => alert.remove(), 500);
                            }
                        } catch (error) {
                            console.warn('Alert auto-hide error:', error);
                            // Ensure cleanup even on error
                            if (alert && alert.parentNode) {
                                alert.remove();
                            }
                        }
                    }, delay);
                });

                // Enhanced Navbar scroll behavior
                let lastScrollTop = 0;
                const navbar = document.querySelector('.frontend-header');
                let ticking = false;

                function updateNavbar() {
                    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                    
                    if (scrollTop > lastScrollTop && scrollTop > 100) {
                        // Scrolling down - hide navbar
                        navbar.style.transform = 'translateY(-100%)';
                    } else {
                        // Scrolling up - show navbar
                        navbar.style.transform = 'translateY(0)';
                    }
                    
                    lastScrollTop = scrollTop <= 0 ? 0 : scrollTop; // For Mobile or negative scrolling
                    ticking = false;
                }

                window.addEventListener('scroll', function() {
                    if (!ticking) {
                        requestAnimationFrame(updateNavbar);
                        ticking = true;
                    }
                }, { passive: true });

                // Enhanced dropdown accessibility
                const dropdownToggles = document.querySelectorAll('[data-bs-toggle="dropdown"]');
                dropdownToggles.forEach(function(toggle) {
                    // Keyboard navigation
                    toggle.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            toggle.click();
                        }
                    });

                    // Close on Escape
                    toggle.addEventListener('keydown', function(e) {
                        if (e.key === 'Escape') {
                            const dropdown = bootstrap.Dropdown.getInstance(toggle);
                            if (dropdown) {
                                dropdown.hide();
                            }
                        }
                    });
                });

                // Mobile menu enhancements
                const navbarToggle = document.querySelector('.navbar-toggler');
                const navbarCollapse = document.querySelector('.navbar-collapse');

                if (navbarToggle && navbarCollapse) {
                    navbarToggle.addEventListener('click', function() {
                        const isExpanded = navbarToggle.getAttribute('aria-expanded') === 'true';
                        
                        // Update ARIA attributes
                        navbarToggle.setAttribute('aria-expanded', !isExpanded);
                        
                        // Trap focus in mobile menu when open
                        if (!isExpanded) {
                            setTimeout(() => {
                                const firstLink = navbarCollapse.querySelector('a');
                                if (firstLink) firstLink.focus();
                            }, 150);
                        }
                    });

                    // Close mobile menu when clicking outside
                    document.addEventListener('click', function(e) {
                        if (!navbar.contains(e.target) && navbarCollapse.classList.contains('show')) {
                            navbarToggle.click();
                        }
                    });
                }

                // Smooth scroll for anchor links
                const anchorLinks = document.querySelectorAll('a[href^="#"]:not([href="#"])');
                anchorLinks.forEach(function(link) {
                    link.addEventListener('click', function(e) {
                        const targetId = this.getAttribute('href').slice(1);
                        const targetElement = document.getElementById(targetId);
                        
                        if (targetElement) {
                            e.preventDefault();
                            
                            // Account for sticky header
                            const headerHeight = navbar ? navbar.offsetHeight : 0;
                            const targetPosition = targetElement.offsetTop - headerHeight - 20;
                            
                            window.scrollTo({
                                top: targetPosition,
                                behavior: 'smooth'
                            });
                            
                            // Update focus for accessibility
                            setTimeout(() => {
                                targetElement.setAttribute('tabindex', '-1');
                                targetElement.focus({ preventScroll: true });
                            }, 500);
                        }
                    });
                });

                // Enhanced error handling for external links
                const externalLinks = document.querySelectorAll('a[target="_blank"]');
                externalLinks.forEach(function(link) {
                    if (!link.hasAttribute('rel')) {
                        link.setAttribute('rel', 'noopener noreferrer');
                    }
                });

                // Performance monitoring for development
                if (window.location.hostname === 'localhost' || window.location.hostname.includes('dev')) {
                    // Monitor render performance
                    if ('performance' in window && 'getEntriesByType' in window.performance) {
                        window.addEventListener('load', function() {
                            setTimeout(function() {
                                const paintEntries = performance.getEntriesByType('paint');
                                paintEntries.forEach(function(entry) {
                                    console.log(`${entry.name}: ${Math.round(entry.startTime)}ms`);
                                });
                            }, 100);
                        });
                    }
                }

            } catch (error) {
                console.error('Frontend JavaScript initialization error:', error);
                
                // Ensure critical functionality still works
                const basicAlerts = document.querySelectorAll(".alert:not(.alert-permanent)");
                basicAlerts.forEach(function(alert) {
                    setTimeout(() => {
                        if (alert && alert.parentNode) {
                            alert.remove();
                        }
                    }, 5000);
                });
            }
        });

        // Global error handler for better debugging
        window.addEventListener('error', function(e) {
            console.error('JavaScript Error:', {
                message: e.message,
                filename: e.filename,
                line: e.lineno,
                column: e.colno,
                error: e.error
            });
        });

        // Unhandled promise rejection handler
        window.addEventListener('unhandledrejection', function(e) {
            console.error('Unhandled Promise Rejection:', e.reason);
        });
    </script>
{% endblock %}
