{% extends 'frontend/base.html.twig' %}

{% block title %}{{ 'site.name'|trans }} - {{ 'homepage.title'|trans }}{% endblock %}

{% block meta_description %}{{ 'homepage.meta_description'|trans }}{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="hero-modern">
    <div class="container hero-content">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6 text-center text-lg-start">
                <h1 class="display-4 fw-bold mb-4">
                    {{ 'homepage.hero.title'|trans }} <br>
                    <span class="text-gradient">{{ 'homepage.hero.subtitle'|trans }}</span>
                </h1>
                <p class="lead mb-5 opacity-90">
                    {{ 'homepage.hero.description'|trans }}
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start">
                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('loan_apply') }}" class="btn btn-light btn-lg hover-lift">
                            <i class="fas fa-plus me-2"></i>{{ 'homepage.hero.cta_new_loan'|trans }}
                        </a>
                        <a href="{{ path('loan_dashboard') }}" class="btn btn-outline-light btn-lg hover-lift">
                            <i class="fas fa-chart-line me-2"></i>{{ 'homepage.hero.cta_dashboard'|trans }}
                        </a>
                    {% else %}
                        <a href="{{ path('app_register') }}" class="btn btn-light btn-lg hover-lift">
                            <i class="fas fa-user-plus me-2"></i>{{ 'homepage.hero.cta_register'|trans }}
                        </a>
                        <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-lg hover-lift">
                            <i class="fas fa-sign-in-alt me-2"></i>{{ 'homepage.hero.cta_login'|trans }}
                        </a>
                    {% endif %}
                </div>
                
                <!-- Stats -->
                <div class="row mt-5 text-center text-lg-start">
                    <div class="col-4">
                        <div class="fw-bold fs-4">500K+</div>
                        <small class="opacity-75">{{ 'homepage.hero.stats_clients'|trans }}</small>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold fs-4">€2.5B+</div>
                        <small class="opacity-75">{{ 'homepage.hero.stats_loans'|trans }}</small>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold fs-4">98%</div>
                        <small class="opacity-75">{{ 'homepage.hero.stats_satisfaction'|trans }}</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="position-relative">
                    <div class="glass p-4 rounded-4 shadow-lg d-inline-block">
                        <i class="fas fa-coins fa-8x text-white opacity-75"></i>
                    </div>
                    <!-- Floating cards for visual appeal -->
                    <div class="position-absolute top-0 end-0 glass p-3 rounded-3 shadow animate__animated animate__fadeInDown animate__delay-1s" style="animation-delay: 1s;">
                        <i class="fas fa-check-circle text-white me-2"></i>
                        <small class="text-white">{{ 'homepage.hero.badge_approved'|trans }}</small>
                    </div>
                    <div class="position-absolute bottom-0 start-0 glass p-3 rounded-3 shadow animate__animated animate__fadeInUp animate__delay-2s" style="animation-delay: 2s;">
                        <i class="fas fa-shield-alt text-white me-2"></i>
                        <small class="text-white">{{ 'homepage.hero.badge_secure'|trans }}</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="py-5" id="services">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">{{ 'homepage.services.title'|trans }}</h2>
                <p class="lead text-muted mb-5">
                    {{ 'homepage.services.subtitle'|trans }}
                </p>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card-modern text-center h-100">
                    <div class="card-body p-4">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-user fa-2x text-primary"></i>
                        </div>
                        <h5 class="fw-bold mb-3">{{ 'homepage.services.personal_loan'|trans }}</h5>
                        <p class="text-muted">{{ 'homepage.services.personal_description'|trans }}</p>
                        <ul class="list-unstyled text-start">
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.personal_up_to'|trans }}</li>
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.personal_rates'|trans }}</li>
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.personal_response'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-3">
                <div class="card-modern text-center h-100">
                    <div class="card-body p-4">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-building fa-2x text-success"></i>
                        </div>
                        <h5 class="fw-bold mb-3">{{ 'homepage.services.business_loan'|trans }}</h5>
                        <p class="text-muted">{{ 'homepage.services.business_description'|trans }}</p>
                        <ul class="list-unstyled text-start">
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.business_up_to'|trans }}</li>
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.business_support'|trans }}</li>
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.business_flexible'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-3">
                <div class="card-modern text-center h-100">
                    <div class="card-body p-4">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-car fa-2x text-warning"></i>
                        </div>
                        <h5 class="fw-bold mb-3">{{ 'homepage.services.auto_loan'|trans }}</h5>
                        <p class="text-muted">{{ 'homepage.services.auto_description'|trans }}</p>
                        <ul class="list-unstyled text-start">
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.auto_new_used'|trans }}</li>
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.auto_rates'|trans }}</li>
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.auto_duration'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6 col-lg-3">
                <div class="card-modern text-center h-100">
                    <div class="card-body p-4">
                        <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-home fa-2x text-info"></i>
                        </div>
                        <h5 class="fw-bold mb-3">{{ 'homepage.services.home_loan'|trans }}</h5>
                        <p class="text-muted">{{ 'homepage.services.home_description'|trans }}</p>
                        <ul class="list-unstyled text-start">
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.home_all_projects'|trans }}</li>
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.home_duration'|trans }}</li>
                            <li><i class="fas fa-check text-success me-2"></i>{{ 'homepage.services.home_fees'|trans }}</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Process Section -->
<section class="py-5 bg-light">
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">{{ 'homepage.process.title'|trans }}</h2>
                <p class="lead text-muted mb-5">
                    {{ 'homepage.process.subtitle'|trans }}
                </p>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                        <span class="fw-bold text-white fs-3">1</span>
                    </div>
                    <h4 class="fw-bold mb-3">{{ 'homepage.process.step1_title'|trans }}</h4>
                    <p class="text-muted">{{ 'homepage.process.step1_description'|trans }}</p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bg-success rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                        <span class="fw-bold text-white fs-3">2</span>
                    </div>
                    <h4 class="fw-bold mb-3">{{ 'homepage.process.step2_title'|trans }}</h4>
                    <p class="text-muted">{{ 'homepage.process.step2_description'|trans }}</p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bg-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                        <span class="fw-bold text-white fs-3">3</span>
                    </div>
                    <h4 class="fw-bold mb-3">{{ 'homepage.process.step3_title'|trans }}</h4>
                    <p class="text-muted">{{ 'homepage.process.step3_description'|trans }}</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="display-5 fw-bold mb-4">{{ 'homepage.features.title'|trans }}</h2>
                <p class="lead text-muted mb-4">
                    {{ 'homepage.features.subtitle'|trans }}
                </p>
                
                <div class="row g-3">
                    <div class="col-12">
                        <div class="d-flex">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                <i class="fas fa-bolt text-primary"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">{{ 'homepage.features.fast.title'|trans }}</h5>
                                <p class="text-muted mb-0">{{ 'homepage.features.fast.description'|trans }}</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12">
                        <div class="d-flex">
                            <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                <i class="fas fa-shield-alt text-success"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">{{ 'homepage.features.secure.title'|trans }}</h5>
                                <p class="text-muted mb-0">{{ 'homepage.features.secure.description'|trans }}</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12">
                        <div class="d-flex">
                            <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                <i class="fas fa-heart text-info"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">{{ 'homepage.features.support.title'|trans }}</h5>
                                <p class="text-muted mb-0">{{ 'homepage.features.support.description'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6 text-center">
                <div class="position-relative">
                    <i class="fas fa-handshake fa-9x text-primary opacity-75"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-primary">
    <div class="container py-5 text-center text-white">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-5 fw-bold mb-4">{{ 'homepage.cta.title'|trans }}</h2>
                <p class="lead mb-5 opacity-90">
                    {{ 'homepage.cta.subtitle'|trans }}
                </p>
                
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('loan_apply') }}" class="btn btn-light btn-lg me-3 hover-lift">
                        <i class="fas fa-plus me-2"></i>{{ 'homepage.cta.apply_loan'|trans }}
                    </a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-light btn-lg me-3 hover-lift">
                        <i class="fas fa-user-plus me-2"></i>{{ 'homepage.cta.create_account'|trans }}
                    </a>
                {% endif %}
                <a href="{{ path('contact') }}" class="btn btn-outline-light btn-lg hover-lift">
                    <i class="fas fa-phone me-2"></i>{{ 'homepage.cta.contact_us'|trans }}
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}