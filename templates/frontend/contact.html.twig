{% extends 'frontend/base.html.twig' %}

{% block title %}{{ 'contact.title'|trans }} - {{ parent() }}{% endblock %}

{% block meta_description %}{{ 'contact.meta_description'|trans }}{% endblock %}

{% block body %}
<div class="container py-5">
    <!-- Page Header -->
    <div class="row text-center mb-5">
        <div class="col-12">
            <h1 class="display-4 mb-3">{{ 'contact.title'|trans }}</h1>
            <p class="lead text-muted">{{ 'contact.subtitle'|trans }}</p>
        </div>
    </div>

    <div class="row">
        <!-- Contact Information -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-envelope text-primary mb-3" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold">{{ 'contact.email.title'|trans }}</h5>
                    <p class="text-muted">{{ 'contact.email.description'|trans }}</p>
                    <a href="mailto:contact@opencms.com" class="btn btn-outline-primary">
                        contact@opencms.com
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-telephone text-primary mb-3" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold">{{ 'contact.phone.title'|trans }}</h5>
                    <p class="text-muted">{{ 'contact.phone.description'|trans }}</p>
                    <a href="tel:+33123456789" class="btn btn-outline-primary">
                        +33 1 23 45 67 89
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-geo-alt text-primary mb-3" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold">{{ 'contact.address.title'|trans }}</h5>
                    <p class="text-muted">{{ 'contact.address.description'|trans }}</p>
                    <address class="mb-0">
                        123 Avenue des Exemples<br>
                        75001 Paris, France
                    </address>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Form -->
    <div class="row mt-5">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-header text-center">
                    <h3 class="fw-bold mb-0">{{ 'contact.form.title'|trans }}</h3>
                </div>
                <div class="card-body">
                    <form id="contactForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="firstName" class="form-label">{{ 'contact.form.first_name'|trans }}</label>
                                <input type="text" class="form-control" id="firstName" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="lastName" class="form-label">{{ 'contact.form.last_name'|trans }}</label>
                                <input type="text" class="form-control" id="lastName" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">{{ 'contact.form.email'|trans }}</label>
                            <input type="email" class="form-control" id="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="subject" class="form-label">{{ 'contact.form.subject'|trans }}</label>
                            <input type="text" class="form-control" id="subject" required>
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">{{ 'contact.form.message'|trans }}</label>
                            <textarea class="form-control" id="message" rows="5" required></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-send me-2"></i>{{ 'contact.form.send'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const contactForm = document.getElementById('contactForm');
            
            if (contactForm) {
                // Form validation and submission
                contactForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    try {
                        // Get form data
                        const formData = new FormData(contactForm);
                        const data = {
                            firstName: formData.get('firstName')?.trim() || '',
                            lastName: formData.get('lastName')?.trim() || '',
                            email: formData.get('email')?.trim() || '',
                            subject: formData.get('subject')?.trim() || '',
                            message: formData.get('message')?.trim() || ''
                        };
                        
                        // Basic validation
                        const errors = [];
                        if (!data.firstName) errors.push('{{ "contact.form.errors.first_name_required"|trans|default("Le prénom est requis") }}');
                        if (!data.lastName) errors.push('{{ "contact.form.errors.last_name_required"|trans|default("Le nom est requis") }}');
                        if (!data.email || !isValidEmail(data.email)) errors.push('{{ "contact.form.errors.email_invalid"|trans|default("Email invalide") }}');
                        if (!data.subject) errors.push('{{ "contact.form.errors.subject_required"|trans|default("Le sujet est requis") }}');
                        if (!data.message) errors.push('{{ "contact.form.errors.message_required"|trans|default("Le message est requis") }}');
                        
                        if (errors.length > 0) {
                            showFormErrors(errors);
                            return;
                        }
                        
                        // Show loading state
                        showFormLoading(true);
                        
                        // Here you would send the data to your server
                        // For now, we'll simulate a successful submission
                        setTimeout(() => {
                            showFormLoading(false);
                            showSuccessMessage();
                            contactForm.reset();
                        }, 1500);
                        
                    } catch (error) {
                        console.error('Form submission error:', error);
                        showFormLoading(false);
                        showErrorMessage('{{ "contact.form.errors.submission_failed"|trans|default("Erreur lors de l\'envoi") }}');
                    }
                });
                
                // Email validation
                function isValidEmail(email) {
                    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    return emailRegex.test(email);
                }
                
                // Show form errors
                function showFormErrors(errors) {
                    const alertHtml = `
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <ul class="mb-0">
                                ${errors.map(error => `<li>${error}</li>`).join('')}
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    `;
                    contactForm.insertAdjacentHTML('beforebegin', alertHtml);
                }
                
                // Show loading state
                function showFormLoading(loading) {
                    const submitButton = contactForm.querySelector('button[type="submit"]');
                    if (submitButton) {
                        if (loading) {
                            submitButton.disabled = true;
                            submitButton.innerHTML = `
                                <span class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">{{ 'common.loading'|trans|default('Chargement...') }}</span>
                                </span>
                                {{ 'contact.form.sending'|trans|default('Envoi en cours...') }}
                            `;
                        } else {
                            submitButton.disabled = false;
                            submitButton.innerHTML = `
                                <i class="bi bi-send me-2"></i>{{ 'contact.form.send'|trans }}
                            `;
                        }
                    }
                }
                
                // Show success message
                function showSuccessMessage() {
                    const alertHtml = `
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>
                            {{ 'contact.form.success_message'|trans|default('Votre message a été envoyé avec succès !') }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    `;
                    contactForm.insertAdjacentHTML('beforebegin', alertHtml);
                }
                
                // Show error message
                function showErrorMessage(message) {
                    const alertHtml = `
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            ${message}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    `;
                    contactForm.insertAdjacentHTML('beforebegin', alertHtml);
                }
            }
        });
    </script>
{% endblock %}
