<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EdgeLoan Admin - {% trans %}Panneau d'Administration{% endtrans %}{% endblock %}</title>
    
    <!-- Meta Tags -->
    <meta name="description" content="{% block meta_description %}{% trans %}Panneau d'administration EdgeLoan - Gestion des prêts et utilisateurs{% endtrans %}{% endblock %}">
    <meta name="robots" content="noindex, nofollow">
    
    <!-- Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    {% block stylesheets %}
    <style>
        :root {
            --admin-primary: #4f46e5;
            --admin-primary-dark: #4338ca;
            --admin-secondary: #6b7280;
            --admin-success: #059669;
            --admin-warning: #d97706;
            --admin-danger: #dc2626;
            --admin-info: #0891b2;
            --admin-light: #f9fafb;
            --admin-dark: #111827;
            --admin-sidebar: #1f2937;
            --admin-sidebar-hover: #374151;
            --admin-border: #e5e7eb;
            --admin-radius: 8px;
            --admin-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
            --admin-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--admin-light);
            margin: 0;
            overflow-x: hidden;
        }
        
        /* Sidebar */
        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 280px;
            background: var(--admin-sidebar);
            color: white;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            z-index: 1050;
            overflow-y: auto;
        }
        
        .admin-sidebar.show {
            transform: translateX(0);
        }
        
        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .sidebar-brand {
            font-size: 1.25rem;
            font-weight: 700;
            color: white;
            text-decoration: none;
        }
        
        .sidebar-nav {
            padding: 1rem 0;
        }
        
        .nav-section {
            padding: 0 1.5rem 1rem;
        }
        
        .nav-section-title {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #9ca3af;
            margin-bottom: 0.5rem;
        }
        
        .nav-link-admin {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.5rem;
            color: #d1d5db;
            text-decoration: none;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        
        .nav-link-admin:hover {
            background-color: var(--admin-sidebar-hover);
            color: white;
            border-left-color: var(--admin-primary);
        }
        
        .nav-link-admin.active {
            background-color: rgba(79, 70, 229, 0.1);
            color: white;
            border-left-color: var(--admin-primary);
        }
        
        .nav-link-admin i {
            width: 20px;
            margin-right: 0.75rem;
        }
        
        /* Main Content */
        .admin-main {
            margin-left: 0;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
        }
        
        .admin-main.shifted {
            margin-left: 280px;
        }
        
        /* Topbar */
        .admin-topbar {
            background: white;
            border-bottom: 1px solid var(--admin-border);
            box-shadow: var(--admin-shadow);
            position: sticky;
            top: 0;
            z-index: 1040;
            padding: 1rem 0;
        }
        
        .topbar-brand {
            font-weight: 700;
            color: var(--admin-primary);
            text-decoration: none;
        }
        
        .sidebar-toggle {
            background: none;
            border: none;
            color: var(--admin-secondary);
            font-size: 1.25rem;
            padding: 0.5rem;
            border-radius: var(--admin-radius);
            transition: all 0.2s ease;
        }
        
        .sidebar-toggle:hover {
            background-color: var(--admin-light);
            color: var(--admin-primary);
        }
        
        /* Content Area */
        .admin-content {
            padding: 2rem;
        }
        
        /* Modern Cards */
        .card-modern-admin {
            border: none;
            border-radius: var(--admin-radius);
            box-shadow: var(--admin-shadow);
            background: white;
            overflow: hidden;
        }
        
        .card-modern-admin .card-header {
            background: var(--admin-light);
            border-bottom: 1px solid var(--admin-border);
            font-weight: 600;
            padding: 1.25rem 1.5rem;
        }
        
        .card-modern-admin .card-body {
            padding: 1.5rem;
        }
        
        /* Stats Cards */
        .stats-card {
            background: white;
            border-radius: var(--admin-radius);
            box-shadow: var(--admin-shadow);
            padding: 1.5rem;
            border-left: 4px solid;
            transition: transform 0.2s ease;
        }
        
        .stats-card:hover {
            transform: translateY(-2px);
        }
        
        .stats-card.primary {
            border-left-color: var(--admin-primary);
        }
        
        .stats-card.success {
            border-left-color: var(--admin-success);
        }
        
        .stats-card.warning {
            border-left-color: var(--admin-warning);
        }
        
        .stats-card.danger {
            border-left-color: var(--admin-danger);
        }
        
        .stats-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }
        
        .stats-label {
            color: var(--admin-secondary);
            font-size: 0.875rem;
            font-weight: 500;
        }
        
        .stats-icon {
            font-size: 2.5rem;
            opacity: 0.3;
        }
        
        /* Buttons */
        .btn-admin {
            font-weight: 500;
            border-radius: var(--admin-radius);
            padding: 0.5rem 1rem;
            transition: all 0.2s ease;
        }
        
        .btn-admin-primary {
            background: var(--admin-primary);
            border-color: var(--admin-primary);
            color: white;
        }
        
        .btn-admin-primary:hover {
            background: var(--admin-primary-dark);
            border-color: var(--admin-primary-dark);
            color: white;
        }
        
        .btn-admin-outline {
            border: 2px solid var(--admin-primary);
            color: var(--admin-primary);
            background: transparent;
        }
        
        .btn-admin-outline:hover {
            background: var(--admin-primary);
            color: white;
        }
        
        /* Tables */
        .table-modern {
            background: white;
            border-radius: var(--admin-radius);
            overflow: hidden;
            box-shadow: var(--admin-shadow);
        }
        
        .table-modern th {
            background: var(--admin-light);
            font-weight: 600;
            border: none;
            padding: 1rem;
        }
        
        .table-modern td {
            padding: 1rem;
            vertical-align: middle;
            border-color: var(--admin-border);
        }
        
        /* Status Badges */
        .badge-admin {
            font-weight: 500;
            font-size: 0.75rem;
            padding: 0.375rem 0.75rem;
            border-radius: 2rem;
        }
        
        .badge-success {
            background: rgba(5, 150, 105, 0.1);
            color: var(--admin-success);
        }
        
        .badge-warning {
            background: rgba(217, 119, 6, 0.1);
            color: var(--admin-warning);
        }
        
        .badge-danger {
            background: rgba(220, 38, 38, 0.1);
            color: var(--admin-danger);
        }
        
        .badge-info {
            background: rgba(8, 145, 178, 0.1);
            color: var(--admin-info);
        }
        
        /* Forms */
        .form-control-admin {
            border: 2px solid var(--admin-border);
            border-radius: var(--admin-radius);
            padding: 0.75rem;
            transition: border-color 0.2s ease;
        }
        
        .form-control-admin:focus {
            border-color: var(--admin-primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }
        
        /* Alerts */
        .alert-admin {
            border: none;
            border-radius: var(--admin-radius);
            padding: 1rem;
            margin-bottom: 1rem;
            border-left: 4px solid;
        }
        
        .alert-success-admin {
            background: rgba(5, 150, 105, 0.1);
            color: #065f46;
            border-left-color: var(--admin-success);
        }
        
        .alert-danger-admin {
            background: rgba(220, 38, 38, 0.1);
            color: #991b1b;
            border-left-color: var(--admin-danger);
        }
        
        .alert-info-admin {
            background: rgba(8, 145, 178, 0.1);
            color: #0c4a6e;
            border-left-color: var(--admin-info);
        }
        
        /* Sidebar Overlay for Mobile */
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1049;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        
        .sidebar-overlay.show {
            opacity: 1;
            visibility: visible;
        }
        
        /* Responsive */
        @media (min-width: 1024px) {
            .admin-sidebar {
                transform: translateX(0);
                position: relative;
                height: auto;
            }
            
            .admin-main {
                margin-left: 280px;
            }
            
            .sidebar-toggle {
                display: none;
            }
        }
        
        @media (max-width: 768px) {
            .admin-content {
                padding: 1rem;
            }
            
            .stats-card {
                margin-bottom: 1rem;
            }
        }
    </style>
    {% endblock %}
</head>
<body>
    <!-- Sidebar -->
    <div class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-header">
            <a href="{{ path('admin_dashboard') }}" class="sidebar-brand">
                <i class="fas fa-coins me-2"></i>EdgeLoan Admin
            </a>
        </div>
        
        <nav class="sidebar-nav">
            <!-- Dashboard -->
            <div class="nav-section">
                <div class="nav-section-title">{% trans %}Principal{% endtrans %}</div>
                <a href="{{ path('admin_dashboard') }}" class="nav-link-admin {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                    <i class="fas fa-chart-pie"></i>
                    {% trans %}Tableau de Bord{% endtrans %}
                </a>
            </div>
            
            <!-- Prêts -->
            <div class="nav-section">
                <div class="nav-section-title">{% trans %}Gestion des Prêts{% endtrans %}</div>
                <a href="{{ path('admin_loans_dashboard') }}" class="nav-link-admin {{ app.request.get('_route') starts with 'admin_loan' ? 'active' : '' }}">
                    <i class="fas fa-money-check-alt"></i>
                    {% trans %}Vue d'Ensemble{% endtrans %}
                </a>
                <a href="{{ path('admin_loan_applications') }}" class="nav-link-admin {{ app.request.get('_route') == 'admin_loan_applications' ? 'active' : '' }}">
                    <i class="fas fa-file-alt"></i>
                    {% trans %}Demandes{% endtrans %}
                </a>
                <a href="{{ path('admin_loan_contracts') }}" class="nav-link-admin {{ app.request.get('_route') == 'admin_loan_contracts' ? 'active' : '' }}">
                    <i class="fas fa-file-contract"></i>
                    {% trans %}Contrats{% endtrans %}
                </a>
                <a href="{{ path('admin_loan_payments') }}" class="nav-link-admin {{ app.request.get('_route') == 'admin_loan_payments' ? 'active' : '' }}">
                    <i class="fas fa-credit-card"></i>
                    {% trans %}Paiements{% endtrans %}
                </a>
                <a href="{{ path('admin_loan_statistics') }}" class="nav-link-admin {{ app.request.get('_route') == 'admin_loan_statistics' ? 'active' : '' }}">
                    <i class="fas fa-chart-bar"></i>
                    {% trans %}Statistiques{% endtrans %}
                </a>
            </div>
            
            <!-- Gestion Contenu -->
            <div class="nav-section">
                <div class="nav-section-title">{% trans %}Contenu{% endtrans %}</div>
                <a href="{{ path('admin_service_index') }}" class="nav-link-admin {{ app.request.get('_route') starts with 'admin_service' ? 'active' : '' }}">
                    <i class="fas fa-cogs"></i>
                    {% trans %}Services{% endtrans %}
                </a>
                <a href="{{ path('admin_media_index') }}" class="nav-link-admin {{ app.request.get('_route') starts with 'admin_media' ? 'active' : '' }}">
                    <i class="fas fa-images"></i>
                    {% trans %}Médias{% endtrans %}
                </a>
            </div>
            
            <!-- Utilisateurs -->
            <div class="nav-section">
                <div class="nav-section-title">{% trans %}Utilisateurs{% endtrans %}</div>
                <a href="{{ path('admin_user_index') }}" class="nav-link-admin {{ app.request.get('_route') starts with 'admin_user' ? 'active' : '' }}">
                    <i class="fas fa-users"></i>
                    {% trans %}Utilisateurs{% endtrans %}
                </a>
            </div>
            
            <!-- Configuration -->
            <div class="nav-section">
                <div class="nav-section-title">{% trans %}Configuration{% endtrans %}</div>
                <a href="{{ path('admin_language_index') }}" class="nav-link-admin {{ app.request.get('_route') starts with 'admin_language' ? 'active' : '' }}">
                    <i class="fas fa-language"></i>
                    {% trans %}Langues{% endtrans %}
                </a>
                <a href="{{ path('admin_translation_index') }}" class="nav-link-admin {{ app.request.get('_route') starts with 'admin_translation' ? 'active' : '' }}">
                    <i class="fas fa-globe"></i>
                    {% trans %}Traductions{% endtrans %}
                </a>
            </div>
        </nav>
    </div>
    
    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    
    <!-- Main Content -->
    <div class="admin-main" id="adminMain">
        <!-- Topbar -->
        <header class="admin-topbar">
            <div class="container-fluid">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <button class="sidebar-toggle me-3" id="sidebarToggle">
                            <i class="fas fa-bars"></i>
                        </button>
                        <a href="{{ path('admin_dashboard') }}" class="topbar-brand d-lg-none">
                            <i class="fas fa-coins me-2"></i>EdgeLoan Admin
                        </a>
                    </div>
                    
                    <div class="d-flex align-items-center gap-3">
                        <!-- Notifications -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-bell"></i>
                                <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">3</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="dropdown-header">{% trans %}Notifications{% endtrans %}</li>
                                <li><a class="dropdown-item" href="#"><i class="fas fa-file-alt me-2 text-info"></i>{% trans %}Nouvelle demande de prêt{% endtrans %}</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fas fa-exclamation-triangle me-2 text-warning"></i>{% trans %}Paiement en retard{% endtrans %}</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2 text-success"></i>{% trans %}Nouvel utilisateur{% endtrans %}</a></li>
                            </ul>
                        </div>
                        
                        <!-- User Menu -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user me-1"></i>{{ app.user.firstName ?? app.user.email }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="{{ path('admin_user_profile') }}"><i class="fas fa-user-cog me-2"></i>{% trans %}Mon Profil{% endtrans %}</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('homepage') }}"><i class="fas fa-external-link-alt me-2"></i>{% trans %}Voir le Site{% endtrans %}</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt me-2"></i>{% trans %}Déconnexion{% endtrans %}</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        
        <!-- Flash Messages -->
        <div class="container-fluid mt-3">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }}-admin alert-dismissible fade show" role="alert">
                        <i class="fas fa-{{ type == 'success' ? 'check-circle' : type == 'error' or type == 'danger' ? 'exclamation-circle' : 'info-circle' }} me-2"></i>
                        {{ message | trans }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
        
        <!-- Page Content -->
        <div class="admin-content">
            {% block body %}{% endblock %}
        </div>
    </div>
    
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    {% block javascripts %}
    <script>
        // Sidebar toggle functionality
        document.addEventListener('DOMContentLoaded', function() {
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('adminSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const main = document.getElementById('adminMain');
            
            function toggleSidebar() {
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
                
                if (window.innerWidth >= 1024) {
                    main.classList.toggle('shifted');
                }
            }
            
            sidebarToggle.addEventListener('click', toggleSidebar);
            overlay.addEventListener('click', toggleSidebar);
            
            // Handle window resize
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 1024) {
                    sidebar.classList.remove('show');
                    overlay.classList.remove('show');
                    main.classList.add('shifted');
                } else {
                    main.classList.remove('shifted');
                }
            });
            
            // Initialize on load
            if (window.innerWidth >= 1024) {
                main.classList.add('shifted');
            }
        });
        
        // Auto-dismiss alerts
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-admin');
            alerts.forEach(function(alert) {
                if (alert.classList.contains('fade')) {
                    bootstrap.Alert.getOrCreateInstance(alert).close();
                }
            });
        }, 5000);
        
        // Confirm delete actions
        function confirmDelete(message) {
            return confirm(message || '{% trans %}Êtes-vous sûr de vouloir supprimer cet élément ?{% endtrans %}');
        }
        
        // Loading states for buttons
        function setButtonLoading(button, loading = true) {
            if (loading) {
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + button.textContent;
            } else {
                button.disabled = false;
                button.innerHTML = button.innerHTML.replace('<span class="spinner-border spinner-border-sm me-2"></span>', '');
            }
        }
    </script>
    {% endblock %}
</body>
</html>