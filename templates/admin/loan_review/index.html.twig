{% extends 'base.html.twig' %}

{% block title %}{{ 'review.my_reviews'|trans }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-2">
                        <i class="bi bi-clipboard2-check me-2"></i>
                        {{ 'review.my_reviews'|trans }}
                    </h1>
                    <p class="text-muted mb-0">{{ 'review.my_reviews_subtitle'|trans }}</p>
                </div>
                {% if is_granted('ROLE_SENIOR_REVIEWER') %}
                    <div class="d-flex gap-2">
                        <a href="{{ path('admin_loan_review_queue') }}" class="btn btn-outline-primary">
                            <i class="bi bi-list-ul me-2"></i>
                            {{ 'review.view_all_queue'|trans }}
                        </a>
                        <a href="{{ path('admin_loan_review_statistics') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-graph-up me-2"></i>
                            {{ 'review.statistics'|trans }}
                        </a>
                    </div>
                {% endif %}
            </div>

            <!-- Workload Overview -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="display-6 text-warning mb-2">{{ workload.pending }}</div>
                            <h6 class="card-title">{{ 'review.status.pending'|trans }}</h6>
                            <small class="text-muted">{{ 'review.awaiting_start'|trans }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="display-6 text-primary mb-2">{{ workload.in_progress }}</div>
                            <h6 class="card-title">{{ 'review.status.in_progress'|trans }}</h6>
                            <small class="text-muted">{{ 'review.currently_working'|trans }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="display-6 text-success mb-2">{{ workload.completed }}</div>
                            <h6 class="card-title">{{ 'review.status.completed'|trans }}</h6>
                            <small class="text-muted">{{ 'review.total_completed'|trans }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="display-6 text-info mb-2">{{ workload.active }}</div>
                            <h6 class="card-title">{{ 'review.active_workload'|trans }}</h6>
                            <div class="progress mt-2" style="height: 4px;">
                                <div class="progress-bar" 
                                     role="progressbar" 
                                     style="width: {{ (workload.active / 10 * 100)|round }}%"
                                     aria-valuenow="{{ workload.active }}" 
                                     aria-valuemin="0" 
                                     aria-valuemax="10">
                                </div>
                            </div>
                            <small class="text-muted">{{ 'review.capacity_indicator'|trans }}</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Pending Reviews -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-clock text-warning me-2"></i>
                                {{ 'review.pending_reviews'|trans }}
                                <span class="badge bg-warning ms-2">{{ pending_reviews|length }}</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            {% if pending_reviews is not empty %}
                                <div class="list-group list-group-flush">
                                    {% for review in pending_reviews %}
                                        <div class="list-group-item list-group-item-action">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1">
                                                        <a href="{{ path('admin_loan_review_show', {id: review.id}) }}" 
                                                           class="text-decoration-none">
                                                            {{ 'loan_application.reference'|trans }} {{ review.application.uuid }}
                                                        </a>
                                                    </h6>
                                                    <p class="mb-1 text-muted">
                                                        <i class="bi bi-cash me-1"></i>
                                                        {{ review.application.amount|number_format(2, ',', ' ') }} € - 
                                                        {{ review.application.purpose|slice(0, 50) }}{% if review.application.purpose|length > 50 %}...{% endif %}
                                                    </p>
                                                    <small class="text-muted">
                                                        <i class="bi bi-calendar me-1"></i>
                                                        {{ 'review.created'|trans }}: {{ review.createdAt|date('d/m/Y H:i') }}
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge {{ review.statusBadgeClass }} mb-1">
                                                        {{ review.status.label|trans }}
                                                    </span>
                                                    <div>
                                                        <a href="{{ path('admin_loan_review_conduct', {id: review.id}) }}" 
                                                           class="btn btn-primary btn-sm">
                                                            <i class="bi bi-play-circle me-1"></i>
                                                            {{ 'review.start'|trans }}
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="bi bi-check2-circle text-muted" style="font-size: 3rem;"></i>
                                    <h5 class="text-muted mt-3">{{ 'review.no_pending.title'|trans }}</h5>
                                    <p class="text-muted">{{ 'review.no_pending.message'|trans }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- In Progress Reviews -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-hourglass-split text-primary me-2"></i>
                                {{ 'review.in_progress_reviews'|trans }}
                                <span class="badge bg-primary ms-2">{{ in_progress_reviews|length }}</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            {% if in_progress_reviews is not empty %}
                                <div class="list-group list-group-flush">
                                    {% for review in in_progress_reviews %}
                                        <div class="list-group-item list-group-item-action">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1">
                                                        <a href="{{ path('admin_loan_review_show', {id: review.id}) }}" 
                                                           class="text-decoration-none">
                                                            {{ 'loan_application.reference'|trans }} {{ review.application.uuid }}
                                                        </a>
                                                    </h6>
                                                    <p class="mb-1 text-muted">
                                                        <i class="bi bi-cash me-1"></i>
                                                        {{ review.application.amount|number_format(2, ',', ' ') }} € - 
                                                        {{ review.application.purpose|slice(0, 50) }}{% if review.application.purpose|length > 50 %}...{% endif %}
                                                    </p>
                                                    <div class="d-flex gap-3">
                                                        <small class="text-muted">
                                                            <i class="bi bi-play-circle me-1"></i>
                                                            {{ 'review.started'|trans }}: {{ review.startedAt|date('d/m/Y H:i') }}
                                                        </small>
                                                        {% set duration = review.durationInDays %}
                                                        {% if duration is not null %}
                                                            <small class="text-muted">
                                                                <i class="bi bi-clock me-1"></i>
                                                                {{ 'review.duration'|trans }}: {{ duration }}
                                                                {{ duration > 1 ? 'review.days'|trans : 'review.day'|trans }}
                                                            </small>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge {{ review.statusBadgeClass }} mb-1">
                                                        {{ review.status.label|trans }}
                                                    </span>
                                                    <div>
                                                        <a href="{{ path('admin_loan_review_conduct', {id: review.id}) }}" 
                                                           class="btn btn-success btn-sm">
                                                            <i class="bi bi-arrow-right-circle me-1"></i>
                                                            {{ 'review.continue'|trans }}
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="bi bi-pause-circle text-muted" style="font-size: 3rem;"></i>
                                    <h5 class="text-muted mt-3">{{ 'review.no_in_progress.title'|trans }}</h5>
                                    <p class="text-muted">{{ 'review.no_in_progress.message'|trans }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            {% if is_granted('ROLE_SENIOR_REVIEWER') %}
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-transparent border-0 py-3">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-lightning me-2"></i>
                                    {{ 'review.quick_actions'|trans }}
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <a href="{{ path('admin_loan_review_queue') }}" class="btn btn-outline-primary w-100 mb-2">
                                            <i class="bi bi-list-ul me-2"></i>
                                            {{ 'review.manage_queue'|trans }}
                                        </a>
                                    </div>
                                    <div class="col-md-4">
                                        <a href="{{ path('admin_loan_review_statistics') }}" class="btn btn-outline-secondary w-100 mb-2">
                                            <i class="bi bi-graph-up me-2"></i>
                                            {{ 'review.view_statistics'|trans }}
                                        </a>
                                    </div>
                                    <div class="col-md-4">
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <form action="{{ path('admin_loan_review_auto_assign') }}" method="post" class="d-inline w-100">
                                                <button type="submit" class="btn btn-outline-warning w-100 mb-2" 
                                                        onclick="return confirm('{{ 'review.auto_assign_confirm'|trans }}')">
                                                    <i class="bi bi-shuffle me-2"></i>
                                                    {{ 'review.auto_assign'|trans }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}