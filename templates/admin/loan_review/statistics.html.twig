{% extends 'base.html.twig' %}

{% block title %}{{ 'review.statistics'|trans }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-2">
                        <i class="bi bi-graph-up me-2"></i>
                        {{ 'review.statistics'|trans }}
                    </h1>
                    <p class="text-muted mb-0">{{ 'review.statistics_subtitle'|trans }}</p>
                </div>
                <div>
                    <a href="{{ path('admin_loan_review_queue') }}" class="btn btn-outline-primary">
                        <i class="bi bi-list-ul me-2"></i>
                        {{ 'review.back_to_queue'|trans }}
                    </a>
                </div>
            </div>

            <!-- Overall Statistics -->
            <div class="row mb-4">
                <div class="col-md-2">
                    <div class="card border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-info mb-2">{{ statistics.total }}</div>
                            <h6 class="card-title">{{ 'review.total_reviews'|trans }}</h6>
                            <small class="text-muted">{{ 'review.all_time'|trans }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-success mb-2">{{ statistics.approved }}</div>
                            <h6 class="card-title">{{ 'review.approved'|trans }}</h6>
                            <small class="text-muted">{{ statistics.approval_rate }}% {{ 'review.rate'|trans }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-danger mb-2">{{ statistics.rejected }}</div>
                            <h6 class="card-title">{{ 'review.rejected'|trans }}</h6>
                            <small class="text-muted">{{ ((statistics.rejected / statistics.total) * 100)|number_format(1) }}% {{ 'review.rate'|trans }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-warning mb-2">{{ statistics.needs_info }}</div>
                            <h6 class="card-title">{{ 'review.needs_info'|trans }}</h6>
                            <small class="text-muted">{{ ((statistics.needs_info / statistics.total) * 100)|number_format(1) }}% {{ 'review.rate'|trans }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-primary mb-2">{{ statistics.average_score ?? 'N/A' }}</div>
                            <h6 class="card-title">{{ 'review.avg_score'|trans }}</h6>
                            <small class="text-muted">{{ 'review.score_range'|trans }}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card border-0 shadow-sm text-center">
                        <div class="card-body">
                            <div class="display-6 text-secondary mb-2">{{ average_review_time ? (average_review_time / 60)|round : 'N/A' }}</div>
                            <h6 class="card-title">{{ 'review.avg_time'|trans }}</h6>
                            <small class="text-muted">{{ 'review.in_hours'|trans }}</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Reviewer Performance -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-person-check me-2"></i>
                                {{ 'review.reviewer_performance'|trans }}
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            {% if workloads is not empty %}
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>{{ 'review.reviewer'|trans }}</th>
                                                <th class="text-center">{{ 'review.status.pending'|trans }}</th>
                                                <th class="text-center">{{ 'review.status.in_progress'|trans }}</th>
                                                <th class="text-center">{{ 'review.status.completed'|trans }}</th>
                                                <th class="text-center">{{ 'review.efficiency'|trans }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for workloadData in workloads %}
                                                {% set reviewer = workloadData.reviewer %}
                                                {% set workload = workloadData.workload %}
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <div class="me-3">
                                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                                                     style="width: 2.5rem; height: 2.5rem; font-size: 0.875rem;">
                                                                    {{ reviewer.firstName|first }}{{ reviewer.lastName|first }}
                                                                </div>
                                                            </div>
                                                            <div>
                                                                <h6 class="mb-0">{{ reviewer.displayName }}</h6>
                                                                <small class="text-muted">{{ reviewer.email }}</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-warning">{{ workload.pending }}</span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-primary">{{ workload.in_progress }}</span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-success">{{ workload.completed }}</span>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="progress" style="height: 6px;">
                                                            {% set efficiency = workload.total > 0 ? (workload.completed / workload.total * 100) : 0 %}
                                                            <div class="progress-bar {{ efficiency >= 80 ? 'bg-success' : (efficiency >= 60 ? 'bg-warning' : 'bg-danger') }}" 
                                                                 style="width: {{ efficiency }}%"></div>
                                                        </div>
                                                        <small class="text-muted">{{ efficiency|number_format(0) }}%</small>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                                    <h5 class="text-muted mt-3">{{ 'review.no_reviewers'|trans }}</h5>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Overdue Reviews -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                                {{ 'review.overdue_reviews'|trans }}
                                <span class="badge bg-danger ms-2">{{ overdue_reviews|length }}</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            {% if overdue_reviews is not empty %}
                                <div class="list-group list-group-flush">
                                    {% for review in overdue_reviews %}
                                        <div class="list-group-item list-group-item-action">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1">
                                                        <a href="{{ path('admin_loan_review_show', {id: review.id}) }}" class="text-decoration-none">
                                                            {{ review.application.uuid }}
                                                        </a>
                                                    </h6>
                                                    <p class="mb-1 text-muted small">
                                                        {{ review.application.applicant.displayName }} - 
                                                        {{ review.application.amount|number_format(0, ',', ' ') }} €
                                                    </p>
                                                    <small class="text-muted">
                                                        {{ 'review.assigned_to'|trans }}: {{ review.reviewer.displayName }}
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge {{ review.statusBadgeClass }} mb-1">{{ review.status.label|trans }}</span>
                                                    <br>
                                                    <small class="text-danger">
                                                        {% set daysOverdue = review.durationInDays %}
                                                        {{ daysOverdue }} {{ 'common.days_overdue'|trans }}
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                <div class="card-footer bg-transparent border-0 pt-0">
                                    <button class="btn btn-outline-danger btn-sm w-100" onclick="escalateOverdueReviews()">
                                        <i class="bi bi-arrow-up-circle me-2"></i>
                                        {{ 'review.escalate_overdue'|trans }}
                                    </button>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                                    <h5 class="text-success mt-3">{{ 'review.no_overdue.title'|trans }}</h5>
                                    <p class="text-muted">{{ 'review.no_overdue.message'|trans }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="row">
                <!-- Decision Distribution Chart -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-pie-chart me-2"></i>
                                {{ 'review.decision_distribution'|trans }}
                            </h5>
                        </div>
                        <div class="card-body">
                            <canvas id="decisionChart" width="400" height="200"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Monthly Review Trends -->
                <div class="col-lg-6 mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-graph-up-arrow me-2"></i>
                                {{ 'review.monthly_trends'|trans }}
                            </h5>
                        </div>
                        <div class="card-body">
                            <canvas id="trendsChart" width="400" height="200"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Decision Distribution Chart
const decisionCtx = document.getElementById('decisionChart').getContext('2d');
new Chart(decisionCtx, {
    type: 'doughnut',
    data: {
        labels: ['{{ 'review.approved'|trans }}', '{{ 'review.rejected'|trans }}', '{{ 'review.needs_info'|trans }}'],
        datasets: [{
            data: [{{ statistics.approved }}, {{ statistics.rejected }}, {{ statistics.needs_info }}],
            backgroundColor: ['#28a745', '#dc3545', '#ffc107'],
            borderWidth: 2,
            borderColor: '#fff'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'bottom'
            }
        }
    }
});

// Monthly Trends Chart (placeholder - would need actual data from backend)
const trendsCtx = document.getElementById('trendsChart').getContext('2d');
new Chart(trendsCtx, {
    type: 'line',
    data: {
        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
        datasets: [{
            label: '{{ 'review.completed'|trans }}',
            data: [12, 19, 15, 25, 22, 30],
            borderColor: '#007bff',
            backgroundColor: 'rgba(0, 123, 255, 0.1)',
            tension: 0.4
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: false
            }
        },
        scales: {
            y: {
                beginAtZero: true
            }
        }
    }
});

function escalateOverdueReviews() {
    if (confirm('{{ 'review.confirm_escalate_overdue'|trans }}')) {
        // Implementation for escalating overdue reviews
        alert('{{ 'review.escalation_functionality_todo'|trans }}');
    }
}
</script>
{% endblock %}