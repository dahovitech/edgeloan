{% extends 'base.html.twig' %}

{% block title %}{{ 'loan.page.my_applications'|trans }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">
                    <i class="bi bi-file-text me-2"></i>
                    {{ 'loan.page.my_applications'|trans }}
                </h1>
                <a href="{{ path('loan_application_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>
                    {{ 'loan.action.new_application'|trans }}
                </a>
            </div>

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem;">
                                        <i class="bi bi-file-text text-primary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted text-uppercase fw-semibold mb-1">{{ 'loan.statistics.total'|trans }}</h6>
                                    <h4 class="mb-0">{{ statistics.total }}</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem;">
                                        <i class="bi bi-pencil-square text-secondary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted text-uppercase fw-semibold mb-1">{{ 'loan.statistics.draft'|trans }}</h6>
                                    <h4 class="mb-0">{{ statistics.draft }}</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem;">
                                        <i class="bi bi-hourglass-split text-warning"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted text-uppercase fw-semibold mb-1">{{ 'loan.statistics.pending'|trans }}</h6>
                                    <h4 class="mb-0">{{ statistics.pending }}</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem;">
                                        <i class="bi bi-check-circle text-success"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted text-uppercase fw-semibold mb-1">{{ 'loan.statistics.approved'|trans }}</h6>
                                    <h4 class="mb-0">{{ statistics.approved }}</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Applications List -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">{{ 'loan.section.applications_list'|trans }}</h5>
                </div>
                <div class="card-body p-0">
                    {% if applications|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>{{ 'loan.table.reference'|trans }}</th>
                                        <th>{{ 'loan.table.amount'|trans }}</th>
                                        <th>{{ 'loan.table.type'|trans }}</th>
                                        <th>{{ 'loan.table.status'|trans }}</th>
                                        <th>{{ 'loan.table.created'|trans }}</th>
                                        <th class="text-end">{{ 'loan.table.actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for application in applications %}
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">{{ application.applicationNumber }}</div>
                                                {% if application.purpose %}
                                                    <small class="text-muted">{{ application.purpose|length > 50 ? application.purpose|slice(0, 50) ~ '...' : application.purpose }}</small>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <span class="fw-semibold">{{ application.amount|number_format(2, '.', ',') }} €</span>
                                                {% if application.requestedDuration %}
                                                    <br><small class="text-muted">{{ application.requestedDuration }} {{ 'loan.unit.months'|trans }}</small>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark">{{ ('loan.type.' ~ application.loanType)|trans }}</span>
                                            </td>
                                            <td>
                                                {% set statusColor = application.statusBadgeClass %}
                                                <span class="badge {{ statusColor }}">
                                                    <i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i>
                                                    {{ ('loan.status.' ~ application.status)|trans }}
                                                </span>
                                            </td>
                                            <td>
                                                <time datetime="{{ application.createdAt|date('c') }}" title="{{ application.createdAt|date('d/m/Y H:i') }}">
                                                    {{ application.createdAt|date('d/m/Y') }}
                                                </time>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group" role="group">
                                                    <a href="{{ path('loan_application_show', {id: application.uuid}) }}" 
                                                       class="btn btn-sm btn-outline-primary" 
                                                       title="{{ 'loan.action.view'|trans }}">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    {% if application.status in ['draft', 'additional_info_required'] %}
                                                        <a href="{{ path('loan_application_edit', {id: application.uuid}) }}" 
                                                           class="btn btn-sm btn-outline-secondary" 
                                                           title="{{ 'loan.action.edit'|trans }}">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="bi bi-inbox display-1 text-muted"></i>
                            </div>
                            <h4 class="text-muted mb-3">{{ 'loan.message.no_applications'|trans }}</h4>
                            <p class="text-muted mb-4">{{ 'loan.message.no_applications_description'|trans }}</p>
                            <a href="{{ path('loan_application_new') }}" class="btn btn-primary btn-lg">
                                <i class="bi bi-plus-circle me-2"></i>
                                {{ 'loan.action.create_first_application'|trans }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Auto-refresh page every 30 seconds to show status updates
        setTimeout(function() {
            if (document.visibilityState === 'visible') {
                location.reload();
            }
        }, 30000);
    </script>
{% endblock %}